[run]
source = core
# Omit the legacy multi-domain "engine" app (app.py), which is a separate
# application from the production app under test (app_prod.py).
omit =
    */__pycache__/*
    */tests/*
    core/engine.py
    core/store.py
    core/ingestion.py
    core/generation.py
    core/llm.py
    core/router.py
    core/suggest.py
    core/config.py
