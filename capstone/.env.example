# ProposalForge Pro — environment configuration
# Copy to .env and fill in what you need. Everything has a safe default;
# with no LLM key the app runs in offline-extractive mode.

# ============================================================
# LLM backend  (priority: Azure OpenAI -> Groq -> Claude -> local -> offline)
# ============================================================
# Azure OpenAI — production connector. On Azure these are injected automatically
# by the Bicep template; set them here only for local testing against Azure OpenAI.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-06-01
# Groq — OpenAI-compatible, has a free tier: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Anthropic Claude: https://console.anthropic.com
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Local OpenAI-compatible server (Ollama/vLLM) — optional
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# ============================================================
# Observability
# ------------------------------------------------------------
# Two independent layers:
#   * METRICS  (how many / how fast)  -> Prometheus via the /metrics endpoint.
#                Scraped by Prometheus/Grafana in infra/docker-compose.yml
#                for LOCAL dev. Always on; no config needed.
#   * TRACING  (what happened in one run) -> Azure Monitor / LangSmith / Langfuse.
#                Auto-selected in priority order below. Off if none are set.
#
# PRODUCTION DEFAULT = Azure Monitor (Application Insights).
#   On Azure this is injected automatically by the Bicep template
#   (infra/deploy/azure/main.bicep provisions App Insights and sets this),
#   so you normally do NOT set it by hand. Uncomment only to test locally:
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...
# AZURE_MONITOR_URL=            # optional: deep link to your App Insights blade

# LangSmith (opt-in — nice for LLM-level traces during development).
# Leave disabled unless you have a key, or it will log connection errors.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-...
# LANGCHAIN_PROJECT=proposalforge
# LANGCHAIN_UI_URL=https://smith.langchain.com   # override for self-hosted

# Langfuse (opt-in — open-source / self-hostable) instead of the above:
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=http://localhost:3001

# Metrics: shared dir so the UI and API processes aggregate on /metrics
PROMETHEUS_MULTIPROC_DIR=/tmp/pf_metrics

# ============================================================
# Vector DB / retrieval
# ============================================================
# auto (default) picks pinecone if a key is present, else faiss, else tfidf
VECTOR_BACKEND=auto
PINECONE_API_KEY=
PINECONE_INDEX=proposalforge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ============================================================
# Application
# ============================================================
APP_ENV=production
APP_DEBUG=False
APP_PORT=8000
API_PORT=8001
LOG_LEVEL=INFO

# Databases (SQLite by default; point DATABASE_URL at Postgres for prod)
DATABASE_URL=sqlite:///./data/proposalforge.db
AUDIT_DB_PATH=data/audit.db
APPROVAL_DB_PATH=data/approvals.db
AUTH_DB_PATH=data/auth.db

# File processing
MAX_FILE_SIZE_MB=50
TEMP_FILE_PATH=temp/
UPLOAD_PATH=data/uploads/

# Guardrails
CONFIDENCE_THRESHOLD=0.6
ENABLE_GUARDRAILS=True
ENABLE_PII_REDACTION=True

# Auth / sessions
REQUIRE_AUTH=true
DEFAULT_ADMIN_PASSWORD=change-me-in-production
SESSION_TTL_SECONDS=28800

# Feature flags
ENABLE_AUTO_SUGGESTIONS=True
ENABLE_HUMAN_APPROVAL=True

# Notifications (optional)
NOTIFY_WEBHOOK_URL=

# Security
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=*
