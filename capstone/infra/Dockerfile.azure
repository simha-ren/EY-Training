# ---- ProposalForge Pro : single-container image for Azure Web App for Containers ----
# Build from the REPO ROOT:  docker build -f infra/Dockerfile.azure -t proposalforge .
# nginx (:8080, the port Azure routes to) multiplexes:
#   /                          -> Streamlit UI (src/ui/app_prod.py)  @127.0.0.1:8000
#   /api/ , /health , /metrics -> FastAPI (src/api/api_server.py)    @127.0.0.1:8001
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PROMETHEUS_MULTIPROC_DIR=/tmp/pf_metrics \
    WEBSITES_PORT=8080

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Python deps first (better layer caching)
COPY requirements.txt .
RUN pip install --upgrade pip && pip install --no-cache-dir -r requirements.txt

# App source (whole repo; .dockerignore keeps it lean)
COPY . .

# nginx config + entrypoint from infra/deploy
RUN cp infra/deploy/nginx.app.conf /etc/nginx/nginx.conf \
    && chmod +x infra/deploy/entrypoint.sh \
    && mkdir -p data logs temp "$PROMETHEUS_MULTIPROC_DIR" /var/log/nginx

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -fsS http://localhost:8080/health || exit 1

CMD ["bash", "infra/deploy/entrypoint.sh"]
