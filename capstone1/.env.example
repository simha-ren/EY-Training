# ProposalForge Pro - Environment Configuration

# Claude API
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-3-5-sonnet-20241022
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_PROJECT=proposalforge

# Application
APP_ENV=production
APP_DEBUG=False
APP_PORT=8000
API_PORT=8001

# Database
DATABASE_URL=sqlite:///./data/proposalforge.db
AUDIT_DB_PATH=data/audit.db
APPROVAL_DB_PATH=data/approvals.db

# File Processing
MAX_FILE_SIZE_MB=50
TEMP_FILE_PATH=temp/
UPLOAD_PATH=data/uploads/

# Guardrails
CONFIDENCE_THRESHOLD=0.6
PII_REDACTION_ENABLED=True
MAX_PII_TOLERANCE=0

# Logging & Monitoring
LOG_LEVEL=INFO
ENABLE_AUDIT_LOGGING=True
AUDIT_LOG_PATH=logs/audit.log

# Deployment
DEPLOYMENT_ENV=azure  # azure, aws, gcp, heroku, digital-ocean, local
AZURE_STORAGE_CONNECTION_STRING=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Security
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=*

# Performance
CACHE_ENABLED=True
CACHE_TTL=3600
MAX_WORKERS=4

# Feature Flags
ENABLE_AUTO_SUGGESTIONS=True
ENABLE_HUMAN_APPROVAL=True
ENABLE_GUARDRAILS=True
ENABLE_PII_REDACTION=True

# --- LLM backend (pick ONE; Groq takes priority if set) ---
# Groq (OpenAI-compatible, has a free tier): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Anthropic Claude: https://console.anthropic.com
CLAUDE_API_KEY=

# --- Vector DB / retrieval ---
# auto (default) picks pinecone if key present, else faiss, else tfidf
VECTOR_BACKEND=auto
# For Pinecone cloud:
PINECONE_API_KEY=
PINECONE_INDEX=proposalforge

# ---- Auth / sessionization ----
REQUIRE_AUTH=true
DEFAULT_ADMIN_PASSWORD=change-me-in-production
SESSION_TTL_SECONDS=28800
AUTH_DB_PATH=data/auth.db

# ---- LLM tracing / observability (optional; free) ----
# LangSmith:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-...
# LANGCHAIN_PROJECT=proposalforge
# Langfuse (open-source, self-hostable):
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=http://localhost:3001

# ---- Observability = LangSmith (Prometheus/Grafana removed) ----
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-your-key
LANGCHAIN_PROJECT=proposalforge
# Optional: override the LangSmith UI base for the in-app link (e.g. self-hosted)
# LANGCHAIN_UI_URL=https://smith.langchain.com
